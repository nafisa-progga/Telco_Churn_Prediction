# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Local environment secrets and temporary files
.env
random.txt

# Large raw/processed data or local runtime snapshots (adjust if tracking small artifacts)
data/raw/*
!data/raw/.gitkeep
data/processed/*.csv
snapshots/*.json